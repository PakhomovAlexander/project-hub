# {{PROJECT_NAME}} Project Hub — top-level tooling.
#
#   make repos        — link the key repos into ./repos (clone what's missing)
#   make repos-check  — fail if any repo is missing or a link is broken (CI)
#   make status       — branch + dirty state across every key repo
#   make list         — print the repo manifest
#
#   make worktree NAME=x             — isolated hub workspace for a parallel agent
#   make worktree-repo NAME=x REPO=y — private worktree of one linked repo (shared-repo case)
#   make worktree-ls                 — list every agent worktree (hub + linked)
#   make worktree-rm NAME=x          — tear an agent's workspaces down
#
#   make session-stats — where the agent harness spends (local transcript aggregates)
#
#   make review-kernel               — fmt + lint + test the Review Kernel crates
#   make review-kernel-fixtures      — prove the synthetic fixtures still reproduce
#   make review-kernel-container-probes — malicious-check probes against a live daemon
#
# TEMPLATE: for a single-repo project, delete the `repos*`/`status`/`list` targets along
# with scripts/repos.sh and repos.manifest, and drop the `worktree-repo` target (keep the
# other `worktree*` targets — parallel agents on the hub's own docs still collide).

.PHONY: help repos repos-check status list \
	worktree worktree-repo worktree-ls worktree-rm session-stats \
	review-kernel review-kernel-fmt review-kernel-lint review-kernel-test \
	review-kernel-fixtures review-kernel-container-probes

help:
	@echo "Targets:"
	@echo "  make repos        — link the key repos into ./repos (clone what's missing)"
	@echo "  make repos-check  — fail if a repo is missing / a link is broken (CI)"
	@echo "  make status       — branch + dirty state across every key repo"
	@echo "  make list         — print the repo manifest"
	@echo "  make worktree NAME=x             — isolated hub workspace for a parallel agent"
	@echo "  make worktree-repo NAME=x REPO=y — private worktree of one linked repo"
	@echo "  make worktree-ls                 — list every agent worktree (hub + linked)"
	@echo "  make worktree-rm NAME=x          — tear an agent's workspaces down"
	@echo "  make session-stats — where the agent harness spends (local transcript aggregates)"
	@echo "  make review-kernel — fmt + lint + test the Review Kernel crates"
	@echo "  make review-kernel-fixtures — prove the synthetic fixtures still reproduce"

repos:
	scripts/repos.sh

repos-check:
	scripts/repos.sh --check

status:
	scripts/repos.sh --status

list:
	scripts/repos.sh --list

# Parallel-agent worktrees — see docs/parallel-agents.md
worktree:
	@scripts/worktree.sh new "$(NAME)" $(BASE)

worktree-repo:
	@scripts/worktree.sh repo "$(NAME)" "$(REPO)" $(BASE)

worktree-ls:
	@scripts/worktree.sh ls

worktree-rm:
	@scripts/worktree.sh rm "$(NAME)"

# Harness self-measurement — see the note in CLAUDE.md
session-stats:
	@scripts/session-stats.sh

# Review Kernel (tools/review-kernel) — backs /self-review-heavy; see
# docs/self-review-heavy.md. Pinned toolchain and committed lockfile.
RK_MANIFEST := tools/review-kernel/Cargo.toml

review-kernel: review-kernel-fmt review-kernel-lint review-kernel-test

review-kernel-fmt:
	cargo +1.88.0 fmt --manifest-path $(RK_MANIFEST) --all -- --check

# -D warnings: a lint gate that only prints is not a gate. The workspace is warning-clean.
review-kernel-lint:
	cargo +1.88.0 clippy --manifest-path $(RK_MANIFEST) --all-targets --locked -- -D warnings

review-kernel-test:
	cargo +1.88.0 test --manifest-path $(RK_MANIFEST) --locked

# The synthetic fixtures are generated by running the legacy shell harness; this proves
# the committed corpus still reproduces byte-for-byte, and that the harness still
# behaves as it claims.
review-kernel-fixtures:
	tools/review-kernel/fixtures/synthetic/generate.sh --check

# The malicious-check.md probes that need real isolation. #[ignore]d in the ordinary
# test run; invoked explicitly here, a missing daemon is a hard failure, never a skip.
review-kernel-container-probes:
	cargo +1.88.0 test --manifest-path $(RK_MANIFEST) --locked --package review-sandbox \
		--test container_probes -- --ignored
