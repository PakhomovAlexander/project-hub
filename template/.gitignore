# The real repo clones live in the workspace ({{CLONE_WORKSPACE}}).
# ./repos holds only symlinks into it, recreated by `make repos` — never tracked.
/repos/

# Machine-local Claude Code overrides. The shared settings.json and the hook ARE
# tracked (so everyone gets the safety gate); only the local override is ignored.
.claude/settings.local.json

# Per-session scratch area — the session-brief hook links it to the session's
# scratchpad (other agents: just mkdir it). Never tracked.
/.scratch

# Hub-owned Rust build output; Cargo.lock stays tracked.
/tools/review-kernel/target/

# Review Kernel campaign state — event logs and artifact stores for local review
# runs. Run state, never repo content.
/.review/runs/

.DS_Store
*.log
*.tmp

# ...except inside the frozen review fixtures: a bundle's check logs are evidence,
# and a fixture that silently loses a file is not a fixture.
!/tools/review-kernel/fixtures/**/*.log
